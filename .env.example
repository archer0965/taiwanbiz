NEXT_PUBLIC_LINE_ID=@469uykad
NEXT_PUBLIC_LINE_URL=https://line.me/R/ti/p/@469uykad

# Gmail SMTP（建議）：到 Google 帳戶 → 安全性 → 應用程式密碼 產生 16 碼
GMAIL_USER=archer0965@gmail.com
GMAIL_APP_PASSWORD=

# 可選替代方案：Resend
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=拓脈諮詢 <onboarding@resend.dev>

# 示範 Credentials 登入（Production 預設關閉；請保持 false）
ALLOW_DEMO_LOGIN=false
# 僅在緊急時開放「任意合法 Email」店主登入；正式請靠租戶 ownerEmail
ALLOW_OWNER_LOGIN=false

# 租戶訂閱持久化：Vercel Blob（Production／Preview／Development 皆需）
# BLOB_READ_WRITE_TOKEN=

# 訂閱金流：綠界 ECPay（AioCheckOut；定期定額亦走 AioCheckOut + Period*）
# 未設定憑證或 ECPAY_FORCE_MOCK=true 時走 mock 示範模式（模擬付款成功）
# 商店代號／HashKey／HashIV 必須來自同一頁「系統介接設定」，且金流收款已開通
# ECPAY_MERCHANT_ID=
# ECPAY_HASH_KEY=
# ECPAY_HASH_IV=
# ECPAY_AIO_ACTION_URL=https://payment.ecpay.com.tw/Cashier/AioCheckOut/V5
# ECPAY_STAGE=true   # 測試環境（需搭配測試特店金鑰）
# ECPAY_FORCE_MOCK=false
# ECPAY_LOGISTICS_MAP_URL=https://logistics.ecpay.com.tw/Express/map
# ECPAY_LOGISTICS_CREATE_URL=https://logistics.ecpay.com.tw/Express/Create
# ECPAY_LOGISTICS_MODE=C2C
# ECPAY_LOGISTICS_MAC=md5
# 綠界已開通、前台可展示的付款（逗號分隔）。網拍未設定時預設僅 cod
# NEXT_PUBLIC_ECPAY_SHOP_PAYMENTS=cod
# 訂閱金流（預設 period,credit,atm,cvs）；設 none／off 可暫時只開放免費試用
# NEXT_PUBLIC_ECPAY_BILLING_PAYMENTS=period,credit,atm,cvs

# SUBSCRIPTION_GRACE_DAYS=3
# CRON_SECRET=請設定隨機字串，供 Vercel Cron / 手動呼叫驗證
# 回調網址（系統自動組）：
#   {AUTH_URL}/api/webhooks/ecpay
#   {AUTH_URL}/api/webhooks/ecpay/payment-info
#   {AUTH_URL}/api/webhooks/ecpay/logistics
#   {AUTH_URL}/api/logistics/emap/callback
