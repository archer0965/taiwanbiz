# Auth.js / NextAuth
AUTH_SECRET=請用 openssl rand -base64 32 產生
AUTH_URL=https://taiwanbiz.vercel.app

# Google OAuth（Google Cloud Console → 憑證 → OAuth 用戶端）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 諮詢表單收件信箱
INQUIRY_TO_EMAIL=archer0965@gmail.com

# 商務聯絡與官方 LINE（預約諮詢／聯絡我們按鈕）
